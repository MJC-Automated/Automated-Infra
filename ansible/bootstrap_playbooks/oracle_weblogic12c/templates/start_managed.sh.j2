#!/bin/bash
# Script to start WebLogic Managed Server {{ managed_server_name }} for {{ domain_name }}

unset DISPLAY
TIME=`/usr/bin/date +%b-%d-%Y-%H%M%S`

export JAVA_HOME="{{ java_home }}"
export PATH="$JAVA_HOME/bin:$PATH"
export USER_MEM_ARGS="{{ weblogic_user_mem_args_effective | default(weblogic_user_mem_args) }}"
export JAVA_OPTIONS="-Djava.net.preferIPv4Stack=true -Dcoherence.clusterport={{ wlst_coherence_port | default(7574) }} -Dcoherence.cluster={{ wlst_domain_name | default(domain_name) }}_Coherence -Dcoherence.localhost={{ wlst_coherence_localhost | default(ansible_host | default('127.0.0.1')) }} -Dcoherence.localport=0 -Dcoherence.localport.adjust=true -Dcoherence.wka={{ wlst_coherence_wka | default(wlst_coherence_localhost | default(ansible_host | default('127.0.0.1'))) }} $JAVA_OPTIONS"

# Ensure GC log target exists before JVM startup so rotation does not fail on missing paths.
GC_LOG_FILE="{{ wlst_gc_log_file | default(weblogic_gc_log_file | default('')) }}"
if [ -n "$GC_LOG_FILE" ]; then
  /usr/bin/mkdir -p "$(dirname "$GC_LOG_FILE")"
  /usr/bin/touch "$GC_LOG_FILE"
fi

echo "INFO: Starting Managed Server {{ managed_server_name }} for {{ wlst_domain_name | default(domain_name) }}"
echo "INFO: Admin URL: {{ wlst_admin_url | default(admin_url) }}"

cd "{{ wlst_domain_home | default(domain_home) }}/bin" || { echo "ERROR: Could not change to domain bin directory."; exit 1; }

START_LOG="{{ managed_server_logs_dir }}/startManaged_{{ managed_server_name }}_$TIME.log"
LISTEN_PORT={{ managed_server_listen_port }}
START_TIMEOUT={{ managed_server_start_timeout_seconds | default(600) }}

nohup ./startManagedWebLogic.sh "{{ managed_server_name }}" "{{ wlst_admin_url | default(admin_url) }}" > "$START_LOG" 2>&1 &

for ((elapsed = 0; elapsed < START_TIMEOUT; elapsed += 5)); do
  if /usr/sbin/ss -H -lnt "sport = :$LISTEN_PORT" | /usr/bin/grep -q LISTEN; then
    echo "INFO: Managed server {{ managed_server_name }} is listening on port $LISTEN_PORT."
    exit 0
  fi
  /usr/bin/sleep 5
done

echo "ERROR: Managed server {{ managed_server_name }} did not listen on port $LISTEN_PORT within ${START_TIMEOUT}s." >&2
exit 1
