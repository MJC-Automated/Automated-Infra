# templates/stop_weblogic.sh.j2
#!/bin/bash
# Script to stop the WebLogic Admin Server for {{ domain_name }}
# Uses domain boot.properties; do not embed the admin password in this script.

TIME=`date +%h-%d-%Y-%s`

# Ensure JAVA_HOME is set for the script context
export JAVA_HOME="{{ java_home }}"
export PATH="$JAVA_HOME/bin:$PATH"
# JMX options from the service drop-in are for the server JVM, not the shutdown client.
unset JAVA_OPTIONS USER_MEM_ARGS

echo "INFO: Stopping WebLogic Admin Server for {{ wlst_domain_name | default(domain_name) }} on port {{ wlst_admin_port | default(admin_port) }}..."
echo "INFO: Logs will be redirected to {{ wlst_domain_logs_dir | default(domain_logs_dir) }}/stopWeblogic_{{ (wlst_domain_name | default(domain_name)) | upper }}_$TIME.log"

# Navigate to domain bin directory and start the server
cd "{{ wlst_domain_home | default(domain_home) }}/bin" || { echo "ERROR: Could not change to domain bin directory."; exit 1; }

STOP_LOG="{{ wlst_domain_logs_dir | default(domain_logs_dir) }}/stopWeblogic_{{ (wlst_domain_name | default(domain_name)) | upper }}_$TIME.log"
LISTEN_PORT={{ wlst_admin_port | default(admin_port) }}
STOP_TIMEOUT={{ admin_server_stop_timeout_seconds | default(300) }}

if ! ./stopWebLogic.sh > "$STOP_LOG" 2>&1; then
  echo "ERROR: WebLogic shutdown command failed; inspect $STOP_LOG." >&2
  exit 1
fi

for ((elapsed = 0; elapsed < STOP_TIMEOUT; elapsed += 5)); do
  if ! /usr/sbin/ss -H -lnt "sport = :$LISTEN_PORT" | /usr/bin/grep -q LISTEN; then
    echo "INFO: Admin server {{ wlst_admin_server_name | default(admin_server_name) }} stopped listening on port $LISTEN_PORT."
    exit 0
  fi
  /usr/bin/sleep 5
done

echo "ERROR: Admin server {{ wlst_admin_server_name | default(admin_server_name) }} still listens on port $LISTEN_PORT after ${STOP_TIMEOUT}s." >&2
exit 1
