#!/usr/bin/env bash
set -euo pipefail

service_name="${1:-}"
if [[ -z "${service_name}" ]] || ! jq -e --arg service "${service_name}" \
  '.data[] | select(."{{ '{#SERVICE}' }}" == $service)' /etc/zabbix/weblogic-jvms.json >/dev/null; then
  echo 0
  exit 0
fi

if systemctl is-active --quiet "${service_name}"; then
  echo 1
else
  echo 0
fi
