services:
{% if observability_kube_state_metrics_enabled | bool %}
  kube-state-metrics:
    image: "{{ observability_kube_state_metrics_image }}"
    container_name: kube-state-metrics
    user: "{{ observability_kube_state_metrics_uid }}:{{ observability_kube_state_metrics_gid }}"
    command:
      - "--kubeconfig=/etc/kubernetes/kubeconfig"
      - "--telemetry-host=0.0.0.0"
      - "--telemetry-port=8081"
    ports:
      - "127.0.0.1:8081:8081"
    volumes:
      - "{{ observability_kubeconfig_path }}:/etc/kubernetes/kubeconfig:ro"
    restart: unless-stopped
{% endif %}
  prometheus:
    image: "{{ observability_prometheus_image }}"
    container_name: prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ observability_prometheus_retention }}"
      - "--web.enable-remote-write-receiver"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "9090:9090"
    volumes:
      - "{{ observability_stack_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      - "{{ observability_stack_dir }}/prometheus/rules:/etc/prometheus/rules:ro"
      - "/var/lib/prometheus:/prometheus"
    restart: unless-stopped

  alertmanager:
    image: "prom/alertmanager:v{{ observability_alertmanager_version }}@{{ observability_alertmanager_amd64_digest }}"
    container_name: alertmanager
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
    ports:
      - "127.0.0.1:9093:9093"
    volumes:
      - "{{ observability_stack_dir }}/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro"
      - "{{ observability_stack_dir }}/alertmanager/templates:/etc/alertmanager/templates:ro"
      - "/var/lib/prometheus/alertmanager:/alertmanager"
    restart: unless-stopped

  blackbox-exporter:
    image: "prom/blackbox-exporter:v{{ observability_blackbox_exporter_version }}"
    container_name: blackbox-exporter
    command:
      - "--config.file=/etc/blackbox_exporter/config.yml"
    cap_add:
      - NET_RAW
    volumes:
      - "{{ observability_stack_dir }}/blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro"
    restart: unless-stopped

  loki:
    image: "{{ observability_loki_image }}"
    container_name: loki
    command: ["-config.file=/etc/loki/local-config.yml"]
    ports:
      - "3100:3100"
    volumes:
      - "{{ observability_stack_dir }}/loki/loki-config.yml:/etc/loki/local-config.yml:ro"
      - "/var/lib/loki:/loki"
    restart: unless-stopped

  tempo:
    image: "{{ observability_tempo_image }}"
    container_name: tempo
    command: ["-config.file=/etc/tempo.yaml"]
    ports:
      - "127.0.0.1:3200:3200"
    volumes:
      - "{{ observability_stack_dir }}/tempo/tempo.yml:/etc/tempo.yaml:ro"
      - "/var/lib/tempo:/var/tempo"
    restart: unless-stopped

  grafana:
    image: "{{ observability_grafana_image }}"
    container_name: grafana
    environment:
      GF_SECURITY_ADMIN_USER: "${OBS_GRAFANA_ADMIN_USER}"
      GF_SECURITY_ADMIN_PASSWORD: "${OBS_GRAFANA_ADMIN_PASSWORD}"
    ports:
      - "3000:3000"
    volumes:
      - "/var/lib/grafana:/var/lib/grafana"
      - "{{ observability_stack_dir }}/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro"
      - "{{ observability_stack_dir }}/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro"
      - "{{ observability_stack_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro"
    restart: unless-stopped

  otel-collector:
    image: "{{ observability_otel_collector_image }}"
    container_name: otel-collector
    command: ["--config=/etc/otelcol-contrib/config.yaml"]
    ports:
      - "4317:4317"
      - "4318:4318"
    volumes:
      - "{{ observability_stack_dir }}/otel/otel-collector-config.yml:/etc/otelcol-contrib/config.yaml:ro"
    restart: unless-stopped
