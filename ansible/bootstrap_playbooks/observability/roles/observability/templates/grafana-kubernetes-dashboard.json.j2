        "query": {
          "query": "label_values(up{job=~\"kube-state-metrics|kube-apiserver|etcd|node\"},environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
