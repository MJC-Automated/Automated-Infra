{
  "uid": "iac-kubernetes-workloads",
  "title": "Kubernetes Workloads (Inventory)",
  "description": "Full Kubernetes observability: kube-state-metrics workloads, Alloy apiserver/etcd scrapes, node host pressure, blackbox probes, and Loki container logs.",
  "tags": [
    "iac",
    "kubernetes"
  ],
  "schemaVersion": 39,
