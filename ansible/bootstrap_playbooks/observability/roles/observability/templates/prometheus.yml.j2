global:
  scrape_interval: {{ observability_prometheus_scrape_interval_seconds }}s
  evaluation_interval: {{ observability_prometheus_scrape_interval_seconds }}s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
{% if observability_kube_state_metrics_enabled | bool %}
  - job_name: kube-state-metrics
    static_configs:
      - targets: ["kube-state-metrics:8080"]
        labels:
          environment: "{{ cluster_environment | default('managed') }}"
          cluster: "{{ observability_kube_state_metrics_cluster }}"
          expected_up: "true"
{% endif %}
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]

  - job_name: tempo
    metrics_path: /metrics
    static_configs:
      - targets: ["tempo:3200"]

  - job_name: otel-collector
    static_configs:
      - targets: ["otel-collector:8889"]

  - job_name: blackbox-exporter
    static_configs:
      - targets: ["blackbox-exporter:9115"]

  - job_name: blackbox-host
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
{% for host in groups.monitoring_clients | default([]) %}
      - targets: ["{{ hostvars[host].ansible_host }}"]
        labels:
          instance: "{{ host }}"
          environment: "{{ hostvars[host].monitoring_environment }}"
          role: "{{ hostvars[host].node_role | default('unknown') }}"
          expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for host in groups.zabbix_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}/zabbix/"]
        labels: { instance: "{{ host }}", service: "zabbix", check: "zabbix/frontend", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% for host in groups.observability_servers | default([]) if host in groups.monitoring_clients | default([]) %}
{% if host == inventory_hostname %}
      - targets: ["http://grafana:3000/api/health"]
{% else %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:3000/api/health"]
{% endif %}
        labels: { instance: "{{ host }}", service: "grafana", check: "observability/grafana", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% if host == inventory_hostname %}
      - targets: ["http://prometheus:9090/-/ready"]
{% else %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:9090/-/ready"]
{% endif %}
        labels: { instance: "{{ host }}", service: "prometheus", check: "observability/prometheus", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% if host == inventory_hostname %}
      - targets: ["http://loki:3100/ready"]
{% else %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:3100/ready"]
{% endif %}
        labels: { instance: "{{ host }}", service: "loki", check: "observability/loki", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% for host in groups.weblogic_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:{{ hostvars[host].admin_port }}/console/"]
        labels: { instance: "{{ host }}", service: "weblogic", check: "weblogic/{{ hostvars[host].domain_name }}/{{ hostvars[host].admin_server_name | default('AdminServer') }}", domain: "{{ hostvars[host].domain_name }}", server: "{{ hostvars[host].admin_server_name | default('AdminServer') }}", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% for domain in hostvars[host].additional_weblogic_domains | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:{{ domain.admin_port }}/console/"]
        labels: { instance: "{{ host }}", service: "weblogic", check: "weblogic/{{ domain.domain_name }}/{{ domain.admin_server_name | default('AdminServer') }}", domain: "{{ domain.domain_name }}", server: "{{ domain.admin_server_name | default('AdminServer') }}", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% endfor %}
{% for host in groups.jenkins_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:8080/login"]
        labels: { instance: "{{ host }}", service: "jenkins", check: "jenkins/controller", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% for host in groups.gitlab_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}/users/sign_in"]
        labels: { instance: "{{ host }}", service: "gitlab", check: "gitlab/web", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% for host in groups.keycloak_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:8080/"]
        labels: { instance: "{{ host }}", service: "keycloak", check: "keycloak/web", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-http-insecure
    metrics_path: /probe
    params:
      module: [http_2xx_insecure]
    static_configs:
{% for host in groups.freeipa_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["https://{{ hostvars[host].ansible_host }}/ipa/ui/"]
        labels: { instance: "{{ host }}", service: "freeipa", check: "freeipa/web", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-weblogic-managed
    metrics_path: /probe
    params:
      module: [http_200_or_404]
    static_configs:
{% for host in groups.weblogic_servers | default([]) if host in groups.monitoring_clients | default([]) %}
{% for server in hostvars[host].managed_servers | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:{{ server.listen_port }}/console/"]
        labels: { instance: "{{ host }}", service: "weblogic-managed", check: "weblogic/{{ hostvars[host].domain_name }}/{{ server.name }}", domain: "{{ hostvars[host].domain_name }}", server: "{{ server.name }}", expected_status: "200_or_404", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% for domain in hostvars[host].additional_weblogic_domains | default([]) %}
{% for server in domain.managed_servers | default([]) %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:{{ server.listen_port }}/console/"]
        labels: { instance: "{{ host }}", service: "weblogic-managed", check: "weblogic/{{ domain.domain_name }}/{{ server.name }}", domain: "{{ domain.domain_name }}", server: "{{ server.name }}", expected_status: "200_or_404", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-kubernetes-api
    metrics_path: /probe
    params:
      module: [http_2xx_insecure]
    static_configs:
{% for host in groups.k8s_control_plane | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["https://{{ hostvars[host].ansible_host }}:6443/livez"]
        labels: { instance: "{{ host }}", service: "kubernetes-api", check: "kubernetes/api", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-kubernetes-etcd
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
{% for host in groups.k8s_etcd | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["{{ hostvars[host].ansible_host }}:2379"]
        labels: { instance: "{{ host }}", service: "kubernetes-etcd", check: "kubernetes/etcd", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-oracle-listener
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
{% for host in groups.oracle_servers | default([]) if host in groups.monitoring_clients | default([]) %}
      - targets: ["{{ hostvars[host].ansible_host }}:1521"]
        labels: { instance: "{{ host }}", service: "oracle-listener", check: "oracle/listener", environment: "{{ hostvars[host].monitoring_environment }}", expected_up: "{{ (hostvars[host].monitoring_expected_up | bool) | ternary('true', 'false') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: blackbox-exporter:9115
