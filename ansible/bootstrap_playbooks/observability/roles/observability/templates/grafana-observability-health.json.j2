  "schemaVersion": 39,
  "tags": ["iac", "observability"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(probe_success{job=\"blackbox-host\"},environment)",
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "query": {
          "query": "label_values(probe_success{job=\"blackbox-host\"},environment)",
          "refId": "PrometheusVariableQueryEditor-Environment"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": "true|false",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "includeAll": true,
        "label": "Expected state",
        "multi": true,
        "name": "expected_up",
        "options": [],
        "query": "true,false",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(probe_success{job=\"blackbox-host\",environment=~\"$environment\",expected_up=~\"$expected_up\"},instance)",
        "includeAll": true,
        "label": "VM",
        "multi": true,
        "name": "instance",
        "query": {
          "query": "label_values(probe_success{job=\"blackbox-host\",environment=~\"$environment\",expected_up=~\"$expected_up\"},instance)",
          "refId": "PrometheusVariableQueryEditor-Instance"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(probe_success{job=~\"blackbox-http|blackbox-http-insecure|blackbox-weblogic-managed|blackbox-oracle-listener|blackbox-kubernetes-api|blackbox-kubernetes-etcd\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\",check=~\".+\"},service)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": {
          "query": "label_values(probe_success{job=~\"blackbox-http|blackbox-http-insecure|blackbox-weblogic-managed|blackbox-oracle-listener|blackbox-kubernetes-api|blackbox-kubernetes-etcd\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\",check=~\".+\"},service)",
          "refId": "PrometheusVariableQueryEditor-Service"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
