{
  "annotations": {"list": []},
  "description": "Inventory-driven infrastructure and service availability. Use the environment, expected-state, VM, and service filters to control scope; planned-off objects remain available through the expected-state filter.",
  "editable": false,
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": ["iac"],
      "targetBlank": false,
      "title": "IaC dashboards",
      "type": "dashboards"
    },
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "targetBlank": true,
      "title": "Prometheus rules",
      "type": "link",
      "url": "{{ observability_prometheus_ui_url | regex_replace('/+$', '') }}/rules"
    }{% if observability_alertmanager_ui_url | length > 0 %},
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "targetBlank": true,
      "title": "Alertmanager",
      "type": "link",
      "url": "{{ observability_alertmanager_ui_url | regex_replace('/+$', '') }}"
    }{% endif %}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "text": "DOWN"},
                "1": {"color": "green", "text": "UP"}
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "targets": [{"expr": "min(up{job=~\"prometheus|alertmanager|loki|tempo|otel-collector|blackbox-exporter\"})", "instant": true}],
      "title": "Stack health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "targets": [{"expr": "avg_over_time(min(up{job=~\"prometheus|alertmanager|loki|tempo|otel-collector|blackbox-exporter\"})[${__range}:1m]) * 100", "instant": true}],
      "title": "Overall Stack Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "targets": [{"expr": "avg(avg_over_time(probe_success{job=\"blackbox-host\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\"}[${__range}])) * 100", "instant": true}],
      "title": "Overall VM Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "text": "DOWN"},
                "1": {"color": "green", "text": "UP"}
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "id": 2,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "targets": [{"expr": "sum(max by (environment, instance) (probe_success{job=\"blackbox-host\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\"}))", "instant": true}],
      "title": "Reachable inventory hosts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "id": 3,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"})", "instant": true}],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
