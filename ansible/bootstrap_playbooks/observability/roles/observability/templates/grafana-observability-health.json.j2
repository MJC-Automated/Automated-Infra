        {
          "expr": "max by (environment, instance, role, target) (probe_success{job=\"blackbox-host\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\"})",
          "legendFormat": "{{ "{{" }}instance{{ "}}" }} · {{ "{{" }}role{{ "}}" }} · {{ "{{" }}target{{ "}}" }}",
