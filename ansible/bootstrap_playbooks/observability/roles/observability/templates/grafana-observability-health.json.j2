      "targets": [
        {
          "expr": "avg by (environment, instance, role, target) (avg_over_time(probe_success{job=\"blackbox-host\",environment=~\"$environment\",instance=~\"$instance\",expected_up=~\"$expected_up\"}[5m])) * 100",
