# Copy to scripts/.env on the Proxmox host and set mode 600.
#
# This file is consumed by scripts/create-cloudinit-vm_stable.sh.
# It configures cloud-init VM defaults and Zabbix Agent 2 bootstrap targets.
# Explicit values exported by the invoking wrapper/Make process take precedence.

CIUSER="ansible"
PASSWORD="<set-strong-cloud-init-password>"
SSH_KEYS_FILE="/root/.ssh/authorized_keys"

# Set to 1 only when every VM produced by this .env is a reusable Packer base.
# This cleans guest identity/state and removes bootstrap-only custom userdata.
# The --template-base and --no-template-base CLI flags override this default.
SANITIZE_TEMPLATE_BASE="0"
SHUTDOWN_FINAL_VM="1"
DO_OS_UPDATE="0"

# Backward-compatible single target (applies to both Server and ServerActive).
ZABBIX_SERVER="198.51.100.43"

# Optional split targets (override ZABBIX_SERVER behavior when set).
# Passive sources must be comma-separated IPv4 addresses or CIDRs because they
# are also the exact guest-firewall sources. ServerActive may include its port.
# ZABBIX_SERVER_PASSIVE="198.51.100.43"
# ZABBIX_SERVER_ACTIVE="198.51.100.43:10051"
